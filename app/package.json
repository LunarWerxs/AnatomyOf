{
  "name": "app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:catalog": "bun run scripts/gen-catalog.ts",
    "gen:tokens": "bun run scripts/gen-tokens.ts",
    "build": "bun run scripts/gen-catalog.ts && bun run scripts/check-grammars.ts && bun run scripts/gen-tokens.ts && vue-tsc -b && vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr && bun run scripts/prerender.ts",
    "preview": "vite preview",
    "check": "bun run check:biome && bun run check:grammars && bun run check:examples",
    "check:biome": "biome check .",
    "check:grammars": "bun run scripts/check-grammars.ts",
    "check:examples": "bun run scripts/check-examples.ts",
    "check:links": "bun run scripts/check-links.ts",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@shikijs/langs": "^4.5.0",
    "@vueuse/core": "^15.0.0",
    "lenis": "^1.3.27",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.11.0",
    "shiki": "^4.5.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
